generator client {
    provider = "prisma-client-js"
}

datasource db{
    provider = "postgresql" 
}

enum EstadoEquipo {
  BUEN_ESTADO
  DANADO
  PERDIDO
}

model Kit {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipos      Equipo[]              
  asignaciones AsignacionKit[]
  historial    HistorialEquipoKit[]
}

model Equipo {
  id        Int          @id @default(autoincrement())
  nombre    String
  marca     String
  modelo    String
  cantidad  Int
  precio    Decimal      @db.Decimal(10, 2)
  estado    EstadoEquipo @default(BUEN_ESTADO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  kitId     Int?          
  kit       Kit?          @relation(fields: [kitId], references: [id])

  detalles  DetalleEquipoAsignacion[]
  historial HistorialEquipoKit[]
}

model Trabajo {
  id          Int       @id @default(autoincrement())
  nombre      String
  cliente     String?
  fechaInicio DateTime
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())

  asignaciones AsignacionKit[]
}

model AsignacionKit {
  id              Int       @id @default(autoincrement())
  trabajoId       Int
  trabajo         Trabajo   @relation(fields: [trabajoId], references: [id])
  kitId           Int
  kit             Kit       @relation(fields: [kitId], references: [id])
  fechaEntrega    DateTime  @default(now())
  fechaDevolucion DateTime?

  detalles        DetalleEquipoAsignacion[]
}

model DetalleEquipoAsignacion {
  id               Int           @id @default(autoincrement())
  asignacionId     Int
  asignacion       AsignacionKit @relation(fields: [asignacionId], references: [id])
  equipoId         Int
  equipo           Equipo        @relation(fields: [equipoId], references: [id])

  estadoEntrega    EstadoEquipo
  estadoDevolucion EstadoEquipo?
  observaciones    String?
}

model HistorialEquipoKit {
  id           Int       @id @default(autoincrement())
  equipoId     Int
  equipo       Equipo    @relation(fields: [equipoId], references: [id])
  kitId        Int
  kit          Kit       @relation(fields: [kitId], references: [id])
  fechaIngreso DateTime  @default(now())
  fechaSalida  DateTime?
  motivo       String?   
}